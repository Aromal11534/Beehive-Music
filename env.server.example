# Copy to .env.server and replace every placeholder before production startup.
FASTAPI_ENV=production
DEBUG=false
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8001

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=beehive
POSTGRES_USER=beehive
POSTGRES_PASSWORD=replace_with_a_strong_database_password
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET_KEY=replace_with_a_different_32_character_secret
INTERNAL_API_TOKEN=replace_with_a_third_independent_32_character_secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

DISCORD_BOT_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_discord_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
DISCORD_REDIRECT_URI=https://beehive.teamsyndicate.org/auth/discord/callback
NEXT_PUBLIC_DISCORD_REDIRECT_URI=https://beehive.teamsyndicate.org/auth/discord/callback

LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace_with_a_strong_lavalink_password
YT_CIPHER_API_TOKEN=replace_with_a_cipher_service_token

API_BASE_URL=http://api:8001
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Beehive
FRONTEND_URL=https://beehive.teamsyndicate.org
CORS_ALLOWED_ORIGINS=https://beehive.teamsyndicate.org
AVATAR_STORAGE_PATH=/app/storage/avatars
AVATAR_MAX_SIZE_MB=5
