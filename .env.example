# ============================================================
# Beehive — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# ============================================================

# ----- COMMON -----
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# ----- DISCORD BOT SERVICE -----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Optional: restrict slash command registration to a single guild for dev
DISCORD_DEV_GUILD_ID=
DISCORD_CLIENT_SECRET=your_secret_from_discord_developer_portal

# ----- LAVALINK -----
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=your_lavalink_password_here

# ----- POSTGRESQL -----
POSTGRES_DB=beehive
POSTGRES_USER=beehive
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----- REDIS -----
REDIS_URL=redis://redis:6379/0

# ----- FASTAPI / API SERVICE -----
FASTAPI_ENV=development
API_HOST=0.0.0.0
API_PORT=8001

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# MFA Encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MFA_ENCRYPTION_KEY=your_fernet_key_here

# Avatar Storage
AVATAR_STORAGE_PATH=/app/storage/avatars
AVATAR_MAX_SIZE_MB=5

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://beehive.syncify.in

# API internal URL (used by bot service)
API_BASE_URL=http://api:8001
INTERNAL_API_TOKEN=generate_a_separate_internal_service_token

# ----- NEXT.JS / WEB SERVICE -----
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WS_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Beehive
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here

# ----- NGINX -----
DOMAIN=beehive.syncify.in
