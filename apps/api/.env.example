# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/beehive

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
SECRET_KEY=generate_a_secure_random_string_here_e.g_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
AVATAR_STORAGE_PATH=/app/uploads/avatars
AVATAR_MAX_SIZE_MB=5

# SMTP / ZeptoMail Configuration
# Example below uses Zoho ZeptoMail SMTP interface
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASSWORD=your_zeptomail_send_token_here
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Beehive Music

# Frontend
FRONTEND_URL=http://localhost:3000
