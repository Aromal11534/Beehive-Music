# The API normally reads the repository-root .env file through Docker Compose.
# These names intentionally mirror app/core/config.py for standalone API use.
FASTAPI_ENV=development
DEBUG=false
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=beehive
POSTGRES_PASSWORD=replace_with_a_database_password
POSTGRES_DB=beehive

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET_KEY=replace_with_a_different_32_character_secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
INTERNAL_API_TOKEN=replace_with_a_third_independent_32_character_secret

DISCORD_CLIENT_ID=replace_with_discord_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

AVATAR_STORAGE_PATH=./storage/avatars
AVATAR_MAX_SIZE_MB=5
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
